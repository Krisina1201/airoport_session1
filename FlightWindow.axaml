<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Airport.FlightWindow"
		Height="500"
		Width="800"
		WindowStartupLocation="CenterScreen"
		x:CompileBindings="False"
        Title="FlightWindow">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<Border DockPanel.Dock="Top"
                BorderBrush="Black"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="20,25,20,30"
			    Grid.Row="0">

			<StackPanel Spacing="10" Name="FilterPanel" >

				<TextBlock Text="Filter by" FontSize="16" FontWeight="Bold"/>

				<StackPanel Orientation="Horizontal">

					<TextBlock Text="From" Margin="30,0,8,0"/>
					<ComboBox MinWidth="150" PlaceholderText="Airport list"
							  x:Name="fromCombobox"/>

					<TextBlock Text="To" Margin="50,0,8,0"/>
					<ComboBox MinWidth="150" PlaceholderText="Airport list" x:Name="toCombobox"/>

					<TextBlock Text="Sort By" Margin="50,0,8,0"/>
					<ComboBox MinWidth="150" PlaceholderText="Time"
							  x:Name="dateTimeCombobox"/>

				</StackPanel>

				<StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">

					<TextBlock Text="Outbound"/>
					<TextBox MinWidth="150" Watermark="yyyy-mm-dd"
							 x:Name="OutboundTextBox" Margin="5,0,0,0"/>

					<TextBlock Text="Flight number" Margin="52,0,10,0"/>
					<TextBox MinWidth="70" Watermark="xxxx" x:Name="flifhtNumberTextBox"/>

					<Button Content="Apply" MinWidth="150" Background="White" BorderBrush="Black"
							HorizontalContentAlignment="Center" Margin="108,0,0,0" Click="FilterClick"/>

				</StackPanel>
			</StackPanel>
		</Border>

		<ScrollViewer Grid.Row="1" Margin="15,0,13,0" VerticalScrollBarVisibility="Auto">
			<DataGrid x:Name="EmployeeDataGrid"
         GridLinesVisibility="All"
          BorderThickness="0.6"
          IsReadOnly="True"
          AutoGenerateColumns="False"
          BorderBrush="Black">
				<DataGrid.Columns>

					<DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='yyyy-MM-dd'}" Width="*"/>
					<DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat='hh\\:mm'}" Width="*"/>
					<DataGridTextColumn Header="From" Binding="{Binding From}" Width="Auto"/>
					<DataGridTextColumn Header="To" Binding="{Binding To}" Width="*"/>
					<DataGridTextColumn Header="Flight number" Binding="{Binding FlightNumber}" Width="*"/>
					<DataGridTextColumn Header="Aircraft" Binding="{Binding Aircraft}" Width="*"/>
					<DataGridTextColumn Header="Economy price" Binding="{Binding EconomyPrice}" Width="*"/>
				</DataGrid.Columns>
			</DataGrid>
		</ScrollViewer>

		<StackPanel Grid.Row="2" Orientation="Horizontal">
			<Button MinWidth="150" Background="White" BorderBrush="Black"
							HorizontalContentAlignment="Center" Margin="15" Click="CancelFlightClick">
				<StackPanel Orientation="Horizontal">
					<Image Source="/resourse/xxx.png" Stretch="Uniform" Height="15" Width="15"/>
					<TextBlock Text="Cancel Flight" Margin="5,0,0,0"/>
				</StackPanel>

			</Button>
			<Button MinWidth="150" Background="White" BorderBrush="Black"
							HorizontalContentAlignment="Center" Margin="15" Click="EditClick">
				<StackPanel Orientation="Horizontal">
					<Image Source="/resourse/pen.png" Stretch="Uniform" Height="15" Width="15"/>
					<TextBlock Text="Edit Flight" Margin="5,0,0,0"/>
				</StackPanel>
			</Button>
			<Button MinWidth="200" Background="White" BorderBrush="Black"
							HorizontalContentAlignment="Center" Margin="150,0,25,0"
					HorizontalAlignment="Right">
				<StackPanel Orientation="Horizontal">
					<Image Source="/resourse/upload.png" Stretch="Uniform" Height="15" Width="15"/>
					<TextBlock Text="Import Changes" Margin="5,0,0,0"/>
				</StackPanel>
			</Button>
			
			<Button Content="Back" Background="White" BorderBrush="Black" Click="backClick"/>
		</StackPanel>
	</Grid>
</Window>
